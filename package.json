{
  "name": "wishtube-desktop",
  "productName": "WishTube",
  "version": "0.3.1",
  "description": "Local-first open video client for Linux, Windows and macOS",
  "author": "wishissue",
  "license": "Apache-2.0",
  "type": "module",
  "main": "main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "vendor": "node scripts/vendor.mjs",
    "dist:linux": "npm run vendor && electron-builder --linux AppImage",
    "dist:win": "npm run vendor && electron-builder --win portable nsis",
    "dist:mac": "npm run vendor && electron-builder --mac dmg zip --x64 --arm64",
    "dist:mac:zip": "npm run vendor && electron-builder --mac zip --x64 --arm64",
    "dist": "npm run vendor && electron-builder --linux AppImage --win portable nsis --mac zip --x64 --arm64"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "hls.js": "1.5.17"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.wishtube.desktop",
    "productName": "WishTube",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "WishTube-${version}-linux-x86_64.AppImage",
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/linux/ia32/**"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "WishTube-${version}-win-x64.${ext}",
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/linux/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WishTube-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/**"
    ],
    "portable": {
      "artifactName": "WishTube-${version}-portable.${ext}"
    },
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "WishTube-${version}-mac-${arch}.${ext}",
      "files": [
        "!node_modules/ffprobe-static/bin/linux/**",
        "!node_modules/ffprobe-static/bin/win32/**"
      ]
    },
    "dmg": {
      "artifactName": "WishTube-${version}-mac-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wishissue/wishtube-desktop-source.git"
  }
}
